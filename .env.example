# heuristic = our own hand-written word-matching engine, no model, sub-ms responses (default)
# laya-mlx  = the actual Laya model via laya-mlx, downloaded once and cached locally
LAYA_BACKEND=heuristic

# Which Hugging Face checkpoint to load when LAYA_BACKEND=laya-mlx
LAYA_MODEL=aac6fef/laya-typed-decisions-mlx
